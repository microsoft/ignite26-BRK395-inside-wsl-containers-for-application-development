[Unit]
Description=Expose the Embedding Arena dashboard on 0.0.0.0:8080 (reachable from Windows as http://localhost:8080)
After=snap.microk8s.daemon-kubelite.service wsl-net-fix.service
Wants=wsl-net-fix.service

[Service]
ExecStart=/snap/bin/microk8s kubectl port-forward --address 0.0.0.0 -n arena svc/arena-dashboard 8080:80
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

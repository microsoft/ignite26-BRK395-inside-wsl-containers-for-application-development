<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MoonrayArrasViewer</RootNamespace>
    <AssemblyName>MoonrayArrasViewer</AssemblyName>

    <!-- The WSL Containers net targets copy the native wslcsdk.dll only when
         PlatformTarget is x64/arm64 (or a matching RuntimeIdentifier is set); AnyCPU
         is rejected. PlatformTarget=x64 alone is enough and keeps the output path
         framework-dependent (no win-x64 RID subfolder). -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Embed registration-free WinRT activation entries (see app.manifest). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WSL.Containers" Version="3.0.3" />
  </ItemGroup>

</Project>
